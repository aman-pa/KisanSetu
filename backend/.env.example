# ===================================================================
# EMAIL CONFIGURATION (OTP & Password Reset)
# ===================================================================
# OPTION 1: Real Gmail Delivery via Google App Password (Recommended)
# To generate GMAIL_PASS:
# 1. Open Google Account -> Security
# 2. Enable 2-Step Verification
# 3. Search "App passwords" -> Create an app named "KisanSetu"
# 4. Paste the generated 16-character password below (without quotes)
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=xxxx-xxxx-xxxx-xxxx

# OPTION 2: Custom SMTP Delivery (Optional fallback)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_EMAIL=postmaster@yourdomain.com
# SMTP_PASSWORD=your_smtp_password

# OPTION 3: Development Test Mode (Automatic)
# If GMAIL_USER and GMAIL_PASS are left blank/commented out, the system
# automatically routes emails to Ethereal Test Inbox and logs the
# one-click clickable preview URL in the backend console.

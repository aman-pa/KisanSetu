PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/kisansetu
JWT_SECRET=kisansetu_sih_super_secret_jwt_key_2026
JWT_EXPIRE=30d
AI_SERVICE_URL=http://localhost:8000

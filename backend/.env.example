# ==============================================================================
# KisanSetu AI - Backend Environment Configuration Example
# Smart India Hackathon 2026
# Copy this file to .env and configure your local/production credentials.
# ==============================================================================

# Server Network Port
PORT=5000

# MongoDB Database Connection String
MONGODB_URI=mongodb://localhost:27017/kisansetu

# Authentication Secret Key (JWT)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE=30d

# Microservice Endpoints
AI_SERVICE_URL=http://localhost:8000
NODE_ENV=development

# Google Gemini Vision API Key (Kept strictly on backend / AI microservice)
GEMINI_API_KEY=your_gemini_api_key_here

# EMAIL CONFIGURATION (OTP & Password Reset)
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=xxxx-xxxx-xxxx-xxxx

# Government Open Data APIs (data.gov.in)
DATAGOV_API_KEY=your_datagov_api_key_here
AGMARKNET_API_KEY=your_agmarknet_api_key_here
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
AGMARKNET_API_URL=https://api.data.gov.in/resource

# Cache Time-to-Live (Minutes)
WEATHER_CACHE_MINUTES=30
MARKET_DATA_CACHE_MINUTES=15
FARMER_HUB_CACHE_MINUTES=60


PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/kisansetu
JWT_SECRET=kisansetu_sih_super_secret_jwt_key_2026
JWT_EXPIRE=30d
AI_SERVICE_URL=http://localhost:8000
NODE_ENV=development

# ===================================================================
# EMAIL CONFIGURATION (OTP & Password Reset)
# ===================================================================
# OPTION 1: Real Gmail Delivery via Google App Password (Recommended)
# To generate GMAIL_PASS:
# 1. Open Google Account -> Security
# 2. Enable 2-Step Verification
# 3. Search "App passwords" -> Create an app named "KisanSetu"
# 4. Paste the generated 16-character password below (without quotes)
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=xxxx-xxxx-xxxx-xxxx

# OPTION 2: Custom SMTP Delivery (Optional fallback)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_EMAIL=postmaster@yourdomain.com
# SMTP_PASSWORD=your_smtp_password

# OPTION 3: Development Test Mode (Automatic)
# If GMAIL_USER and GMAIL_PASS are left blank/commented out, the system
# automatically routes emails to Ethereal Test Inbox and logs the
# one-click clickable preview URL in the backend console.

# ===================================================================
# LIVE AGRICULTURAL DATA PROVIDER (Optional / Government Agmarknet)
# ===================================================================
# In standard testing/demo mode, KisanSetu automatically utilizes the
# SeededDataProvider backed by high-fidelity APMC historical database records.
# To connect to live Government data.gov.in / Agmarknet APIs, obtain an API key
# from https://data.gov.in and configure the variables below:
# AGMARKNET_API_KEY=your_datagov_api_key_here
# AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
# AGMARKNET_API_URL=https://api.data.gov.in/resource
